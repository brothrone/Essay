{
  "name": "essay",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "자소서 · 스펙 관리 윈도우 데스크톱 앱",
  "author": "brothrone",
  "homepage": "https://github.com/hyilkimm/Essay",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyilkimm/Essay.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "start": "npm run build && electron .",
    "installer:art": "electron scripts/make-installer-art.cjs",
    "app:build": "npm run build && electron-builder --win --x64",
    "app:build:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.53.0",
    "oxlint": "^1.81.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.brothrone.essay",
    "productName": "Essay",
    "copyright": "© brothrone",
    "publish": [
      {
        "provider": "github",
        "owner": "hyilkimm",
        "repo": "Essay",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Essay-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Essay",
      "uninstallDisplayName": "Essay (자소서 · 스펙 관리)",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "displayLanguageSelector": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
